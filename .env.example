# Copy to .env and fill in real values. .env is gitignored — keep it that way.
# These must also be set in Vercel: Project → Settings → Environment Variables,
# for Production, Preview AND Development.

# Password for the /database alumni table. Any non-empty string.
# If this is unset, every login is refused and the sheet route returns 503 —
# the page fails closed rather than open.
DATABASE_PASSWORD=choose-a-password

# The long id from the alumni spreadsheet's URL.
GOOGLE_SHEET_ID=the-long-id-from-the-spreadsheet-url

# THE WHOLE service-account JSON, on one line — NOT a path to the file.
# This is the opposite of the usual Google SDK convention and the most common
# setup mistake on this project. Generate with: jq -c . google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account","project_id":"..."}
